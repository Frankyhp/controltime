<UserControl x:Class="ControlTime.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ControlTime.App.Views"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="BorderBrush" Value="#FFB9C4D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFF7FAFD" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF5A6B80" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Border Padding="16"
                    Margin="0,0,0,12"
                    BorderBrush="#FFB9C4D4"
                    BorderThickness="1"
                    Background="#FFFFFFFF">
                <StackPanel>
                    <TextBlock Text="Estado de acceso actual" Foreground="#FF5A6B80" FontSize="12" />
                    <TextBlock Text="{Binding StateText}"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{Binding StateBrush}" />
                    <TextBlock Text="{Binding ReasonText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding NextAllowedText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="#FFB71C1C"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardLabel}" Text="Uso registrado hoy" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding UsageText}" />
                </StackPanel>
            </Border>

            <WrapPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardLabel}" Text="Actividad" />
                        <TextBlock Style="{StaticResource CardValue}"
                                   Text="{Binding ActivityText}"
                                   Foreground="{Binding ActivityBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardLabel}" Text="Límite diario configurado" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding LimitText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardLabel}" Text="Bonus de hoy" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding BonusText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardLabel}" Text="Asignación efectiva" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding AllowanceText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardLabel}" Text="Tiempo restante" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding RemainingText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardLabel}" Text="Horario activo" />
                        <TextBlock Style="{StaticResource CardValue}" Text="{Binding ScheduleText}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
