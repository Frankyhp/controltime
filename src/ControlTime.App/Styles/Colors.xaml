<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EA" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2430" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6B80" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3949AB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#303F9F" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EEF0FA" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#1B5E20" />
    <SolidColorBrush x:Key="SuccessBg" Color="#E8F5E9" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E65100" />
    <SolidColorBrush x:Key="WarningBg" Color="#FFF4E5" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B71C1C" />
    <SolidColorBrush x:Key="DangerBg" Color="#FDECEA" />
    <SolidColorBrush x:Key="InfoBg" Color="#EEF0FA" />

    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E8EAF6" />
    <SolidColorBrush x:Key="FocusVisualBrush" Color="#3949AB" />

</ResourceDictionary>
