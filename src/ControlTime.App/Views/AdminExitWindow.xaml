<Window x:Class="ControlTime.App.Views.AdminExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salir de ControlTime"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="Introduce la contraseña de administrador para salir de ControlTime."
                   TextWrapping="Wrap"
                   MaxWidth="320" />
        <PasswordBox x:Name="PasswordBoxControl" Width="260" HorizontalAlignment="Left" Margin="0,10,0,0" />
        <TextBlock x:Name="ErrorText"
                   Margin="0,8,0,0"
                   Foreground="#FFB00000"
                   Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Salir" Padding="12,4" Margin="0,0,8,0" IsDefault="True" Click="OnAcceptClick" />
            <Button Content="Cancelar" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
