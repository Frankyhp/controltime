<Window x:Class="ControlTime.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ControlTime.App.Views"
        xmlns:vm="clr-namespace:ControlTime.App.ViewModels"
        mc:Ignorable="d"
        Title="ControlTime" Height="640" Width="960">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <views:RulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsageHistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFE8EEF6" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Dashboard"
                             GroupName="Navigation"
                             IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                             Command="{Binding ShowDashboardCommand}"
                             VerticalAlignment="Center"
                             Margin="4,0,12,0" />
                <RadioButton Content="Reglas"
                             GroupName="Navigation"
                             IsChecked="{Binding IsRulesSelected, Mode=OneWay}"
                             Command="{Binding ShowRulesCommand}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0" />
                <RadioButton Content="Historial"
                             GroupName="Navigation"
                             IsChecked="{Binding IsHistorySelected, Mode=OneWay}"
                             Command="{Binding ShowHistoryCommand}"
                             VerticalAlignment="Center"
                             Margin="0,0,12,0" />
                <RadioButton Content="Ajustes"
                             GroupName="Navigation"
                             IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                             Command="{Binding ShowSettingsCommand}"
                             VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding Current}" />
    </DockPanel>
</Window>
