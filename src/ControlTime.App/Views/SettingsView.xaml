<UserControl x:Class="ControlTime.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:ControlTime.App.Views"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel Margin="12">
        <Border Margin="0,0,0,8"
                Padding="10"
                Background="#FFF6E3B8"
                Visibility="{Binding ShowSetupPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Primera vez en ControlTime: establece la contraseña de administrador (mínimo 8 caracteres). Será necesaria para modificar la configuración." />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <PasswordBox x:Name="SetupPasswordBox" Width="220" Margin="0,0,8,0" />
                    <PasswordBox x:Name="SetupConfirmPasswordBox" Width="220" Margin="0,0,8,0" />
                    <Button Content="Establecer contraseña" Padding="10,4" Click="OnSetupPasswordClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,0,0,8"
                Padding="10"
                Background="#FFE8EEF6"
                Visibility="{Binding ShowUnlockPanel, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="Zona protegida. Introduce la contraseña de administrador para modificar la configuración." />
                <PasswordBox x:Name="UnlockPasswordBox" Width="220" Margin="0,0,8,0" />
                <Button Content="Entrar" Padding="10,4" Click="OnUnlockClick" />
            </StackPanel>
        </Border>

        <Border Margin="0,0,0,8"
                Padding="10"
                Background="#FFDDEEDD"
                Visibility="{Binding ShowAdminBar, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="Modo administrador activado (expira automáticamente en unos minutos)." />
                <Button Content="Bloquear ahora" Padding="10,4" Command="{Binding LockAdminCommand}" />
            </StackPanel>
        </Border>

        <GroupBox Header="Contraseña de administrador" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}">
            <StackPanel Margin="4">
                <TextBlock Text="Contraseña actual" />
                <PasswordBox x:Name="CurrentPasswordBox" Width="260" HorizontalAlignment="Left"
                             Margin="0,2,0,10" />
                <TextBlock Text="Contraseña nueva (mínimo 8 caracteres)" />
                <PasswordBox x:Name="NewPasswordBox" Width="260" HorizontalAlignment="Left"
                             Margin="0,2,0,10" />
                <TextBlock Text="Repite la contraseña nueva" />
                <PasswordBox x:Name="ConfirmPasswordBox" Width="260" HorizontalAlignment="Left"
                             Margin="0,2,0,10" />
                <Button Content="Cambiar contraseña" Padding="12,4" HorizontalAlignment="Left"
                        Click="OnChangePasswordClick" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Arranque" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <CheckBox Content="Iniciar ControlTime con Windows"
                          IsChecked="{Binding AutoStartEnabled, Mode=OneWay}"
                          Command="{Binding ToggleAutoStartCommand}"
                          IsEnabled="{Binding CanEdit}" />
                <TextBlock Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           FontStyle="Italic"
                           Foreground="Gray"
                           Text="Requiere modo administrador. Se guarda en HKCU\Software\Microsoft\Windows\CurrentVersion\Run." />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Bloqueo de seguridad" Margin="0,0,0,8">
            <TextBlock Margin="4"
                       TextWrapping="Wrap"
                       Text="{Binding EnforcementStatusText}" />
        </GroupBox>

        <StackPanel Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap"
                       Foreground="#FFB00000"
                       Text="{Binding ErrorMessage}" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="#FF1B7A1B"
                       Text="{Binding StatusMessage}" />
        </StackPanel>
    </StackPanel>
</UserControl>
