<Application x:Class="ControlTime.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControlTime.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
                <ResourceDictionary Source="Styles/Inputs.xaml" />
                <ResourceDictionary Source="Styles/Cards.xaml" />
                <ResourceDictionary Source="Styles/Navigation.xaml" />
                <ResourceDictionary Source="Styles/Tables.xaml" />
                <ResourceDictionary Source="Styles/Banners.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBox}" />
            <Style TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBox}" />
            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
            <Style TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}" />
            <Style TargetType="ListViewItem" BasedOn="{StaticResource AppListViewItem}" />
            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource AppGridViewColumnHeader}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
