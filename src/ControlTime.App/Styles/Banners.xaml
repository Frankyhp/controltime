<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Plain Border styles: each usage composes glyph + text explicitly in the view. -->

    <SolidColorBrush x:Key="InfoLineBrush" Color="#3949AB" Opacity="0.30" />
    <SolidColorBrush x:Key="SuccessLineBrush" Color="#1B5E20" Opacity="0.30" />
    <SolidColorBrush x:Key="WarningLineBrush" Color="#E65100" Opacity="0.35" />
    <SolidColorBrush x:Key="DangerLineBrush" Color="#B71C1C" Opacity="0.30" />

    <Style x:Key="StatusBanner" TargetType="Border">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource InfoBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource InfoLineBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InfoBanner" TargetType="Border" BasedOn="{StaticResource StatusBanner}" />

    <Style x:Key="SuccessBanner" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{StaticResource SuccessBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessLineBrush}" />
    </Style>

    <Style x:Key="WarningBanner" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{StaticResource WarningBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}" />
    </Style>

    <Style x:Key="DangerBanner" TargetType="Border" BasedOn="{StaticResource StatusBanner}">
        <Setter Property="Background" Value="{StaticResource DangerBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerLineBrush}" />
    </Style>

</ResourceDictionary>
