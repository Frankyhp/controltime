<Window x:Class="ControlTime.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ControlTime.App.Views"
        xmlns:vm="clr-namespace:ControlTime.App.ViewModels"
        mc:Ignorable="d"
        Title="ControlTime" Height="700" Width="1100"
        Icon="/Assets/controltime.ico"
        MinHeight="600" MinWidth="880"
        Background="{StaticResource AppBackgroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <views:RulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsageHistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource AppBackgroundBrush}" Padding="12,16,12,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="ControlTime"
                           Style="{StaticResource PageTitle}"
                           Margin="12,0,0,16" />
                <StackPanel Style="{StaticResource NavRailPanel}">
                    <RadioButton Style="{StaticResource NavRailItem}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsDashboardSelected, Mode=OneWay}"
                                 Command="{Binding ShowDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       Text="&#xE80F;"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRailItem}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsRulesSelected, Mode=OneWay}"
                                 Command="{Binding ShowRulesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       Text="&#xE90F;"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Reglas" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRailItem}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsHistorySelected, Mode=OneWay}"
                                 Command="{Binding ShowHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       Text="&#xE81C;"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Historial" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavRailItem}"
                                 GroupName="Navigation"
                                 IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                                 Command="{Binding ShowSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}"
                                       Text="&#xE713;"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,12,12,12">
            <ContentControl Content="{Binding Current}" />
        </Border>
    </Grid>
</Window>
