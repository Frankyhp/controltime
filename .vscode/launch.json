{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ControlTime (debug: sin bloqueo de sesión)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ControlTime",
      "program": "${workspaceFolder}/src/ControlTime.App/bin/Debug/net10.0-windows/ControlTime.App.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "env": {
        "CONTROLTIME_ENFORCEMENT": "off"
      }
    },
    {
      "name": "ControlTime (debug: con bloqueo de sesión)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ControlTime",
      "program": "${workspaceFolder}/src/ControlTime.App/bin/Debug/net10.0-windows/ControlTime.App.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
